      "name": "no_such_member",
      "kind": "business",
      "detector": {
        "kind": "text_present",
        "text": "No member found",
        "scope": null,
        "frame_path": []
      },
      "binds": [],
      "description": "The supplied member id matches no record. A declared answer, not a failure."
    },
    {
      "name": "found",
