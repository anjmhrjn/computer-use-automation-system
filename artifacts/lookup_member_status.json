{
  "schema_version": "1.0",
  "capability_id": "memberserve.lookup_member_status",
  "version": "1.0.0",
  "name": "Look up member plan status",
  "description": "Given a member id, return the member's plan status and renewal date from the MemberServe member record, or report that no such member exists.",
  "target": {
    "app_id": "memberserve",
    "app_version": "3.1",
    "surface_kind": "web",
    "location_pattern": "/member*"
  },
  "inputs": [
    {
      "name": "member_id",
      "value_type": "string",
      "required": true,
      "sensitivity": "pii",
      "description": "MemberServe member identifier, as printed on the member card."
    }
  ],
  "outputs": [
    {
      "name": "plan_status",
      "value_type": "string",
      "description": "Coverage status of the member's plan, e.g. Active, Lapsed, Suspended."
    },
    {
      "name": "renewal_date",
      "value_type": "date",
      "description": "Date the member's plan next renews."
    }
  ],
  "outcomes": [
